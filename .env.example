# Copy to .env (repo root) and adjust. Never commit the real .env.
# Used both by the backend run locally (uv run …) and by docker compose (variable substitution + env_file of `api`).

# --- docker compose ---
# Password of the `db` (Postgres) container; compose builds the api's DATABASE_URL from it
# (postgresql+psycopg://tac:<POSTGRES_PASSWORD>@db:5432/tac), overriding DATABASE_URL below.
# Set it before the first `docker compose up`: Postgres only applies it when the volume is created.
POSTGRES_PASSWORD=tac

# --- this app's database for a run outside Docker (./tac.sh local): the compose `db` container, published on
# localhost:15433 in dev (docker-compose.override.yml). Overridden inside compose.
DATABASE_URL=postgresql+psycopg://tac:tac@localhost:15433/tac

# --- sessions ---
JWT_SECRET=please-generate-a-long-random-string   # openssl rand -hex 32
JWT_TTL_HOURS=8
COOKIE_SECURE=false            # true behind HTTPS

# --- bootstrap HR admin (local account, always HR_ADMIN) ---
ADMIN_USERNAME=admin.drh
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Administrateur DRH

# --- offline / dev mode: LDAP users log in with this shared password while LDAP_ENABLED=false ---
# Set it to an empty value in production.
DEV_PASSWORD=sunu-dev

# --- Active Directory (same directory as sunu-achats) ---
LDAP_ENABLED=false
LDAP_URL=ldap://10.12.12.108:389
LDAP_USE_TLS=false
LDAP_BASE_DN=OU=SUNU_GROUP,DC=sunu-group,DC=com
LDAP_BIND_DN=CN=<service-account>,CN=Users,DC=sunu-group,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=user)
# nightly directory sync hour (0-23); leave empty to disable
LDAP_SYNC_CRON_HOUR=

MIN_GROUP_SIZE=5
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- Claude (Anthropic) AI features ---
# Leave empty to disable every AI feature (the app works normally without it).
# Claude only ever receives scores, profiles and question text — never names, usernames or e-mails.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# coach + HR assistant messages per user per day
AI_DAILY_LIMIT=30

# --- natural read-aloud ---
# Leave both keys empty to use the browser's built-in voice instead. Users pick a voice in the test.
# Only the text being read is sent (never who is reading). Audio is cached on disk, so each fixed
# question is synthesised only once per voice.
# Google Cloud Text-to-Speech API key (preferred when set; restrict it to the Text-to-Speech API):
GOOGLE_TTS_API_KEY=
# or Azure AI Speech:
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# default voice id; empty = best French voice (e.g. fr-FR-Chirp3-HD-Aoede, fr-FR-Neural2-F, fr-FR-DeniseNeural)
TTS_VOICE=
# audio cache folder (local run only; compose sets /data/tts-cache, a persistent volume)
# TTS_CACHE_DIR=backend/.tts-cache
