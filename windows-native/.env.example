# SUNU TAC - native Windows install settings (C:\sunu-tac\.env).
# install.cmd creates .env from this file on the first install (database password, secrets, paths filled in).
# After editing .env:  Restart-Service SunuTAC   (PowerShell as administrator)

# --- web ---
# port of the test and console: http://<server>:8080/  and  http://<server>:8080/admin/
HTTP_PORT=8080
# built frontend served by the API (set by install.cmd)
WEB_DIR=
# true once the site is served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=[]

# --- database (local PostgreSQL, set by install.cmd) ---
DATABASE_URL=

# --- sessions ---
JWT_SECRET=
JWT_TTL_HOURS=8

# --- HR admin (local account, created at startup with the HR_ADMIN role) ---
ADMIN_USERNAME=admin.drh
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur DRH

# empty in production (no shared password for directory users)
DEV_PASSWORD=

# --- Active Directory ---
LDAP_ENABLED=true
LDAP_URL=ldap://10.12.12.108:389
LDAP_USE_TLS=false
LDAP_BASE_DN=OU=SUNU_GROUP,DC=sunu-group,DC=com
LDAP_BIND_DN=CN=<service-account>,CN=Users,DC=sunu-group,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=user)
# nightly directory sync hour (0-23); empty = manual sync from the console
LDAP_SYNC_CRON_HOUR=2

MIN_GROUP_SIZE=5

# --- Claude AI features (empty = off) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_DAILY_LIMIT=30

# --- natural read-aloud (empty = browser voice) ---
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE=
# audio cache folder (set by install.cmd)
TTS_CACHE_DIR=
