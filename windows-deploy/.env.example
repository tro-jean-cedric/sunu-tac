# SUNU TAC — server settings. Copy to .env (build-and-push.sh does it for you with random secrets).
# Never commit the real .env.

# --- images (pushed by build-and-push.sh) ---
IMAGE_PREFIX=ghcr.io/tro-jean-cedric/sunu-tac
# "latest" or a specific build tag (git sha) to pin / roll back
TAG=latest
# port on the Windows machine: test http://<pc>:8080/  and HR console http://<pc>:8080/admin/
HTTP_PORT=8080

# --- database (internal to Docker; DATABASE_URL is built from this) ---
POSTGRES_PASSWORD=change-me

# --- sessions ---
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_TTL_HOURS=8
# true once the site is served over HTTPS
COOKIE_SECURE=false

# --- HR admin (local account, created at startup with the HR_ADMIN role) ---
ADMIN_USERNAME=admin.drh
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrateur DRH

# empty in production (no shared password for directory users)
DEV_PASSWORD=

# --- Active Directory ---
LDAP_ENABLED=true
LDAP_URL=ldap://10.12.12.108:389
LDAP_USE_TLS=false
LDAP_BASE_DN=OU=SUNU_GROUP,DC=sunu-group,DC=com
LDAP_BIND_DN=CN=<service-account>,CN=Users,DC=sunu-group,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=user)
# nightly directory sync hour (0-23); empty = manual sync from the console
LDAP_SYNC_CRON_HOUR=2

MIN_GROUP_SIZE=5
# same-origin behind nginx: no CORS needed
CORS_ORIGINS=[]

# --- Claude AI features (empty = off) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_DAILY_LIMIT=30

# --- natural read-aloud (empty = browser voice) ---
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE=
